# Supabase -> Project Settings -> API keys
# Kopiraj v .env.local in vpiši prave vrednosti (.env.local ni na GitHubu).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Mapa na serverju, iz katere aplikacija sinhronizira izvoze (bere samo strežnik Next.js v omrežju podjetja)
SYNC_MAPA=//rokadasrv/RISPSQL$/Dokumentacija/Podatki za aplikacije
